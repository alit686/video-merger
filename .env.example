# Video Merger — متغيرات البيئة

# قاعدة Turso (إلزامي)
TURSO_DATABASE_URL=turso://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<your-turso-token>

# اختياري: حدود قابلة للضبط (تعديلها اختياري)
MAX_SOURCES=10
SOURCE_MAX_MB=200
OUTPUT_MAX_MB=150
MAX_TOTAL_DURATION_SEC=600
FFMPEG_PRESET=medium

# اختياري: حماية /api/cron (Vercel يرسل Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# للاختبارات المحلية فقط — 1 يسمح بمصادر localhost/الشبكات الخاصة.
# اتركه فارغًا في الإنتاج (حماية SSRF مفعّلة افتراضيًا).
ALLOW_PRIVATE_SOURCES=